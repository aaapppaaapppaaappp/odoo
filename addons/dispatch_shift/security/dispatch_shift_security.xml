<?xml version="1.0" ?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_dispatch">
        <field name="name">Dispatch Shift</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_dispatch_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_dispatch"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="group_dispatch_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_dispatch_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_dispatch"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
