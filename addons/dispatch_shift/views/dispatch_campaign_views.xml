<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dispatch_campaign_view_form" model="ir.ui.view">
        <field name="name">dispatch.campaign.form</field>
        <field name="model">dispatch.campaign</field>
        <field name="arch" type="xml">
            <form string="Campaign">
                <header>
                    <button name="action_open" type="object"
                            string="Open" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_generate_slots" type="object"
                            string="Generate Slots" class="btn-primary"
                            invisible="state != 'open'"/>
                    <button name="action_invite_employees" type="object"
                            string="Invite Employees" icon="fa-envelope"
                            invisible="state != 'open'"/>
                    <button name="action_close" type="object"
                            string="Close"
                            invisible="state != 'open'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            invisible="state in ('closed', 'cancelled')"
                            confirm="Are you sure you want to cancel this campaign?"/>
                    <button name="action_draft" type="object"
                            string="Reset to Draft"
                            invisible="state not in ('cancelled', 'closed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_templates" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="template_count" widget="statinfo"
                                   string="Templates"/>
                        </button>
                        <button name="action_view_slots" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <field name="slot_count" widget="statinfo"
                                   string="Slots"/>
                        </button>
                        <button name="action_view_invited" type="object"
                                class="oe_stat_button" icon="fa-users"
                                invisible="invited_count == 0">
                            <field name="invited_count" widget="statinfo"
                                   string="Invited"/>
                        </button>
                        <button name="action_view_frozen" type="object"
                                class="oe_stat_button" icon="fa-ban"
                                invisible="frozen_count == 0">
                            <field name="frozen_count" widget="statinfo"
                                   string="Frozen"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Campaign Name"/>
                        </h1>
                    </div>
                    <group col="2">
                        <group>
                            <field name="job_id"/>
                            <field name="client_id"/>
                            <field name="timezone"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="max_consecutive_days"/>
                            <field name="invite_only"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Shift Templates" name="templates">
                            <field name="template_ids">
                                <list editable="bottom">
                                    <field name="store_id"/>
                                    <field name="shift_label"/>
                                    <field name="start_hour" widget="float_time"/>
                                    <field name="end_hour" widget="float_time"/>
                                    <field name="capacity"/>
                                </list>
                            </field>
                        </page>
                        <page string="Invited Employees" name="invited_employees">
                            <field name="invited_employee_ids" nolabel="1">
                                <list>
                                    <field name="name"/>
                                    <field name="work_email"/>
                                    <field name="work_phone"/>
                                    <field name="category_ids" widget="many2many_tags"
                                           options="{'color_field': 'color'}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Frozen Employees" name="frozen_employees">
                            <field name="frozen_employee_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="work_email"/>
                                    <field name="work_phone"/>
                                    <field name="category_ids" widget="many2many_tags"
                                           options="{'color_field': 'color'}"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="dispatch_campaign_view_list" model="ir.ui.view">
        <field name="name">dispatch.campaign.list</field>
        <field name="model">dispatch.campaign</field>
        <field name="arch" type="xml">
            <list string="Campaigns" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="job_id" optional="show"/>
                <field name="client_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="template_count" string="Templates"/>
                <field name="slot_count" string="Slots"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'open'"
                       decoration-info="state == 'draft'"
                       decoration-muted="state in ('closed', 'cancelled')"/>
            </list>
        </field>
    </record>

    <record id="dispatch_campaign_view_search" model="ir.ui.view">
        <field name="name">dispatch.campaign.search</field>
        <field name="model">dispatch.campaign</field>
        <field name="arch" type="xml">
            <search string="Search Campaigns">
                <field name="name"/>
                <field name="job_id"/>
                <field name="client_id"/>
                <filter name="draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="open" string="Open"
                        domain="[('state', '=', 'open')]"/>
                <filter name="closed" string="Closed"
                        domain="[('state', '=', 'closed')]"/>
                <separator/>
                <group>
                    <filter name="group_by_job" string="Job Position"
                            context="{'group_by': 'job_id'}"/>
                    <filter name="group_by_client" string="Client"
                            context="{'group_by': 'client_id'}"/>
                    <filter name="group_by_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="dispatch_campaign_action" model="ir.actions.act_window">
        <field name="name">Campaigns</field>
        <field name="res_model">dispatch.campaign</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
