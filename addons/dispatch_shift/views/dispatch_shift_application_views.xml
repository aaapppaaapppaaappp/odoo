<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dispatch_shift_application_view_form" model="ir.ui.view">
        <field name="name">dispatch.shift.application.form</field>
        <field name="model">dispatch.shift.application</field>
        <field name="arch" type="xml">
            <form string="Application">
                <header>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-primary"
                            invisible="state != 'applied'"/>
                    <button name="action_reject" type="object"
                            string="Reject" class="btn-secondary"
                            invisible="state not in ('applied', 'confirmed')"
                            confirm="Reject this application?"/>
                    <button name="action_reject_campaign" type="object"
                            string="Block" class="btn-secondary"
                            invisible="state not in ('applied', 'confirmed', 'waitlisted')"
                            confirm="Reject ALL applications for this employee in this campaign? The employee will be blocked from applying again."/>
                    <field name="is_frozen" invisible="1"/>
                    <button name="action_release" type="object"
                            string="Release" class="btn-secondary"
                            invisible="state != 'rejected'"
                            confirm="Release this rejection? The employee will be able to reapply to this slot."/>
                    <button name="action_unfreeze_campaign" type="object"
                            string="Unfreeze from Campaign" class="btn-secondary"
                            invisible="state != 'rejected' or not is_frozen"
                            confirm="Unfreeze this employee? They will be able to apply to this campaign again."/>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="btn-secondary"
                            invisible="state not in ('applied', 'confirmed', 'waitlisted')"
                            confirm="Cancel this application?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="applied,confirmed"/>
                </header>
                <sheet>
                    <group col="2">
                        <group>
                            <field name="employee_id"/>
                            <field name="slot_id"/>
                            <field name="applied_at"/>
                        </group>
                        <group>
                            <field name="slot_date"/>
                            <field name="store_id"/>
                            <field name="campaign_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="dispatch_shift_application_view_list" model="ir.ui.view">
        <field name="name">dispatch.shift.application.list</field>
        <field name="model">dispatch.shift.application</field>
        <field name="arch" type="xml">
            <list string="Applications">
                <field name="employee_id"/>
                <field name="slot_date"/>
                <field name="store_id"/>
                <field name="campaign_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'applied'"
                       decoration-success="state == 'confirmed'"
                       decoration-warning="state == 'waitlisted'"
                       decoration-danger="state in ('rejected', 'cancelled')"/>
                <field name="applied_at"/>
                <button name="action_confirm" type="object"
                        string="Confirm" class="btn-link"
                        invisible="state != 'applied'"/>
                <button name="action_reject" type="object"
                        string="Reject" class="btn-link"
                        invisible="state not in ('applied', 'confirmed')"/>
                <button name="action_cancel" type="object"
                        string="Cancel" class="btn-link"
                        invisible="state not in ('applied', 'confirmed', 'waitlisted')"/>
                <button name="action_reject_campaign" type="object"
                        string="Block" class="btn-link text-danger"
                        invisible="state not in ('applied', 'confirmed', 'waitlisted')"
                        confirm="Reject ALL applications for this employee in this campaign? The employee will be blocked from applying again."/>
                <button name="action_release" type="object"
                        string="Release" class="btn-link"
                        invisible="state != 'rejected'"
                        confirm="Release this rejection? The employee will be able to reapply to this slot."/>
            </list>
        </field>
    </record>

    <record id="dispatch_shift_application_view_search" model="ir.ui.view">
        <field name="name">dispatch.shift.application.search</field>
        <field name="model">dispatch.shift.application</field>
        <field name="arch" type="xml">
            <search string="Search Applications">
                <field name="employee_id"/>
                <field name="store_id"/>
                <field name="campaign_id"/>
                <filter name="applied" string="Applied"
                        domain="[('state', '=', 'applied')]"/>
                <filter name="confirmed" string="Confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter name="waitlisted" string="Waitlisted"
                        domain="[('state', '=', 'waitlisted')]"/>
                <filter name="rejected" string="Rejected"
                        domain="[('state', '=', 'rejected')]"/>
                <filter name="cancelled" string="Cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <group>
                    <filter name="group_by_employee" string="Employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_by_store" string="Store"
                            context="{'group_by': 'store_id'}"/>
                    <filter name="group_by_campaign" string="Campaign"
                            context="{'group_by': 'campaign_id'}"/>
                    <filter name="group_by_date" string="Date"
                            context="{'group_by': 'slot_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="dispatch_shift_application_action" model="ir.actions.act_window">
        <field name="name">Applications</field>
        <field name="res_model">dispatch.shift.application</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_applied': 1}</field>
    </record>
</odoo>
