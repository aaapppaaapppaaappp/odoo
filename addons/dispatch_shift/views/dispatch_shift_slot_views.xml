<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dispatch_shift_slot_view_form" model="ir.ui.view">
        <field name="name">dispatch.shift.slot.form</field>
        <field name="model">dispatch.shift.slot</field>
        <field name="arch" type="xml">
            <form string="Shift Slot">
                <sheet>
                    <group col="2">
                        <group>
                            <field name="template_id"/>
                            <field name="campaign_id"/>
                            <field name="store_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="shift_label"/>
                            <field name="start_hour" widget="float_time"/>
                            <field name="end_hour" widget="float_time"/>
                            <field name="capacity"/>
                            <field name="confirmed_count"/>
                            <field name="seats_available"/>
                            <field name="is_full"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Applications" name="applications">
                            <field name="application_ids">
                                <list>
                                    <field name="employee_id"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'confirmed'"
                                           decoration-warning="state == 'waitlisted'"
                                           decoration-danger="state in ('rejected', 'cancelled')"/>
                                    <field name="applied_at"/>
                                    <button name="action_reject" type="object"
                                            string="Reject" class="btn-link"
                                            invisible="state != 'confirmed'"
                                            confirm="Reject this application?"/>
                                    <button name="action_cancel" type="object"
                                            string="Cancel" class="btn-link"
                                            invisible="state not in ('confirmed', 'waitlisted')"
                                            confirm="Cancel this application?"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dispatch_shift_slot_view_list" model="ir.ui.view">
        <field name="name">dispatch.shift.slot.list</field>
        <field name="model">dispatch.shift.slot</field>
        <field name="arch" type="xml">
            <list string="Shift Slots"
                  decoration-success="seats_available &gt; 0"
                  decoration-warning="is_full">
                <field name="date"/>
                <field name="store_id"/>
                <field name="shift_label"/>
                <field name="start_hour" widget="float_time"/>
                <field name="end_hour" widget="float_time"/>
                <field name="capacity"/>
                <field name="confirmed_count"/>
                <field name="seats_available"/>
                <field name="is_full" column_invisible="1"/>
                <field name="campaign_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="dispatch_shift_slot_view_calendar" model="ir.ui.view">
        <field name="name">dispatch.shift.slot.calendar</field>
        <field name="model">dispatch.shift.slot</field>
        <field name="arch" type="xml">
            <calendar string="Shift Slots" date_start="date" mode="month"
                      color="store_id" event_limit="5">
                <field name="store_id"/>
                <field name="shift_label"/>
                <field name="confirmed_count"/>
                <field name="capacity"/>
            </calendar>
        </field>
    </record>

    <record id="dispatch_shift_slot_view_search" model="ir.ui.view">
        <field name="name">dispatch.shift.slot.search</field>
        <field name="model">dispatch.shift.slot</field>
        <field name="arch" type="xml">
            <search string="Search Slots">
                <field name="campaign_id"/>
                <field name="store_id"/>
                <field name="date"/>
                <filter name="available" string="Available"
                        domain="[('is_full', '=', False)]"/>
                <filter name="full" string="Full"
                        domain="[('is_full', '=', True)]"/>
                <separator/>
                <group>
                    <filter name="group_by_date" string="Date"
                            context="{'group_by': 'date'}"/>
                    <filter name="group_by_store" string="Store"
                            context="{'group_by': 'store_id'}"/>
                    <filter name="group_by_campaign" string="Campaign"
                            context="{'group_by': 'campaign_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="dispatch_shift_slot_action" model="ir.actions.act_window">
        <field name="name">Shift Slots</field>
        <field name="res_model">dispatch.shift.slot</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'search_default_group_by_date': 1}</field>
    </record>
</odoo>
