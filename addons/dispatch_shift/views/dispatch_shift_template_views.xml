<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dispatch_shift_template_view_form" model="ir.ui.view">
        <field name="name">dispatch.shift.template.form</field>
        <field name="model">dispatch.shift.template</field>
        <field name="arch" type="xml">
            <form string="Shift Template">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group col="2">
                        <group>
                            <field name="campaign_id"/>
                            <field name="store_id"/>
                            <field name="shift_label"/>
                        </group>
                        <group>
                            <field name="start_hour" widget="float_time"/>
                            <field name="end_hour" widget="float_time"/>
                            <field name="capacity"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dispatch_shift_template_view_list" model="ir.ui.view">
        <field name="name">dispatch.shift.template.list</field>
        <field name="model">dispatch.shift.template</field>
        <field name="arch" type="xml">
            <list string="Shift Templates">
                <field name="campaign_id"/>
                <field name="store_id"/>
                <field name="shift_label"/>
                <field name="start_hour" widget="float_time"/>
                <field name="end_hour" widget="float_time"/>
                <field name="capacity"/>
            </list>
        </field>
    </record>

    <record id="dispatch_shift_template_view_search" model="ir.ui.view">
        <field name="name">dispatch.shift.template.search</field>
        <field name="model">dispatch.shift.template</field>
        <field name="arch" type="xml">
            <search string="Search Templates">
                <field name="campaign_id"/>
                <field name="store_id"/>
                <field name="shift_label"/>
                <group>
                    <filter name="group_by_campaign" string="Campaign"
                            context="{'group_by': 'campaign_id'}"/>
                    <filter name="group_by_store" string="Store"
                            context="{'group_by': 'store_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="dispatch_shift_template_action" model="ir.actions.act_window">
        <field name="name">Shift Templates</field>
        <field name="res_model">dispatch.shift.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
